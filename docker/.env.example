# Copy to docker/.env and adjust paths.
#
#   cd docker && cp .env.example .env
#
# Non-secret values only. compose.yaml reads this file to fill ${...}; the containers get
# only the keys compose.yaml lists under `environment:`, so an API key put here reaches nothing.
# Keys go to the file store on the workspace mount (persisted on the host):
#   docker compose run --rm -T cli mas-ctl secrets init
#   printf %s "$KEY" | docker compose run --rm -T cli mas-ctl secrets set openai
# (`secrets set` reads the value from stdin, never from the command line.)
# After edits: task restart (from repo root).

# The LLM endpoint is set in the infra manifest (`proxy.api_base`, or an overlay), not here.

# Dev-only: skip TLS certificate verification. Needed behind a corporate proxy
# that intercepts TLS (otherwise: "TLS certificate verification failed"). NOT for
# shared/prod use — prefer mounting the corporate CA bundle + SSL_CERT_FILE.
# MAS_LLM_VERIFY_SSL=0

# --- Host paths mounted into containers ---
# Workspace: config.yaml, labs/, infra/, project .env
# Default ".." mounts the repository root when you run compose from docker/
MAS_WORKSPACE_MOUNT=..

# Persistent data: trace cache, benchmark outputs, run artifacts.
# To inspect output someone shared with you, point this at your data dir instead,
# e.g. MAS_DATA_MOUNT=~/.local/share/mas (drop their labs/<name> output under it).
MAS_DATA_MOUNT=./data

# Optional host XDG config directory used as the Docker user-config fallback.
# The project config.yaml mounted at /workspace still takes precedence.
# MAS_XDG_CONFIG_MOUNT=${HOME}/.config/mas

# Directory the Experiment page reads runs from (MAS_LAB_ROOT/labs). Pin it at the
# mounted /data so the API reads the same place the benchmark writes to — otherwise
# it defaults to the workspace and misses both your runs and any shared output.
MAS_LAB_ROOT=/data

# Optional: mount host ~/.mas into the container (user config + legacy paths)
# MAS_USER_CONFIG_MOUNT=~/.mas

# --- Published ports ---
# Host address the ports are published on. Keep 127.0.0.1 unless the network is trusted.
MAS_BIND_ADDRESS=127.0.0.1
MAS_BACKEND_PORT=8090
MAS_UI_PORT=8080

# API URL injected into the UI (browser on the host reaches this address)
VITE_API_BASE_URL=http://localhost:8090
