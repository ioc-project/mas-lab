# Fail fast on lint before the remote sees branch commits. Install: task install-hooks
# This is not a merge gate. GitHub Actions job "ci-summary" is the merge proof.
set -euo pipefail

run_lint=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/tags/*) ;;
    *) run_lint=1 ;;
  esac
done

if [ "$run_lint" -eq 0 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
exec task verify-lint
